<Project>
    <!--
        Defines the TargetFrameworks available to each MultiTarget.
        Can be overridden by the user to enable / disable individual TargetFramworks per MultiTarget.
        Does not define the EnabledTargetFrameworks, which are used to build the project.
     -->
    <PropertyGroup>
        <!-- See https://github.com/CommunityToolkit/Tooling-Windows-Submodule/pull/235#issuecomment-2530131559 -->
        <UwpTargetFrameworks Condition="'$(UwpTargetFrameworks)' == '' AND '$(BuildingInsideVisualStudio)' == 'true'">uap10.0.17763;</UwpTargetFrameworks>

        <!-- We also include 'net9.0-windows10.0.26100.0' explicitly for UWP as a workaround for https://github.com/CommunityToolkit/Tooling-Windows-Submodule/issues/238 -->
        <UwpTargetFrameworks Condition="'$(UwpTargetFrameworks)' == '' AND '$(BuildingInsideVisualStudio)' != 'true'">uap10.0.17763;net8.0-windows10.0.26100.0;net9.0-windows10.0.26100.0;</UwpTargetFrameworks>
        <WinAppSdkTargetFrameworks Condition="'$(WinAppSdkTargetFrameworks)' == ''">net9.0-windows10.0.26100.0;net8.0-windows10.0.26100.0;</WinAppSdkTargetFrameworks>
        
        <!-- Uno 5.x (WinUI 2) targets .NET 9, Uno 7.x (WinUI 3) requires .NET 10 -->
        <UnoDotNetTargetFramework Condition="'$(UnoDotNetTargetFramework)' == '' AND '$(WinUIMajorVersion)' == '3'">net10.0</UnoDotNetTargetFramework>
        <UnoDotNetTargetFramework Condition="'$(UnoDotNetTargetFramework)' == ''">net9.0</UnoDotNetTargetFramework>

        <WasmHeadTargetFramework Condition="'$(WasmHeadTargetFramework)' == ''">$(UnoDotNetTargetFramework);</WasmHeadTargetFramework>
        <LinuxHeadTargetFramework Condition="'$(LinuxHeadTargetFramework)' == ''">$(UnoDotNetTargetFramework);</LinuxHeadTargetFramework>
        <WpfHeadTargetFramework Condition="'$(WpfHeadTargetFramework)' == ''">$(UnoDotNetTargetFramework);</WpfHeadTargetFramework>

        <AndroidLibTargetFrameworks Condition="'$(AndroidLibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework)-android;</AndroidLibTargetFrameworks>
        <MacOSLibTargetFrameworks Condition="'$(MacOSLibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework)-maccatalyst;</MacOSLibTargetFrameworks>
        <iOSLibTargetFrameworks Condition="'$(iOSLibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework)-ios;</iOSLibTargetFrameworks>

        <!-- Used for comparison to current TargetFramework -->
        <LinuxLibTargetFrameworks Condition="'$(LinuxLibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework);</LinuxLibTargetFrameworks>
        <WasmLibTargetFrameworks Condition="'$(WasmLibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework);</WasmLibTargetFrameworks>
        <WpfLibTargetFrameworks Condition="'$(WpfLibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework);</WpfLibTargetFrameworks>
        <Win32LibTargetFrameworks Condition="'$(Win32LibTargetFrameworks)' == ''">$(UnoDotNetTargetFramework);</Win32LibTargetFrameworks>

        <!-- Used for defining TargetFramework under platforms that need it -->
        <DotnetStandardCommonTargetFramework Condition="'$(DotnetStandardCommonTargetFramework)' == ''">netstandard2.0;</DotnetStandardCommonTargetFramework>
        <DotnetCommonTargetFramework Condition="'$(DotnetCommonTargetFramework)' == ''">$(UnoDotNetTargetFramework);</DotnetCommonTargetFramework>
    </PropertyGroup>
</Project>