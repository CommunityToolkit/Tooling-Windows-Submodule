<!-- Nuget package dependencies for all deployable Uno project heads that use WinUI 3  -->
<!-- Due to the quirks of non-sdk style projects, we cannot create a unified Dependencies.props for deployable head. -->
<Project>
  <ItemGroup>
    <!--<PackageReference Include="Uno.CommunityToolkit.WinUI.UI.Controls.Markdown" Version="7.1.100-dev.15.g12261e2626" />-->
    <PackageReference Include="Uno.Microsoft.Xaml.Behaviors.Interactivity.WinUI" Version="3.0.3" />
    <PackageReference Include="Uno.WinUI.Lottie" Version="7.0.0-dev.1656" />
    <!-- Powers the gallery source code viewer, ColorCode.WinUI is Windows-only -->
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
  </ItemGroup>

  <!-- Set once a Labs MarkdownTextBlock build with Uno 7 targets is published, until then docs render as plain text -->
  <PropertyGroup Condition="'$(LabsMarkdownTextBlockVersion)' != ''">
    <DefineConstants>$(DefineConstants);HAS_LABS_MARKDOWNTEXTBLOCK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LabsMarkdownTextBlockVersion)' != ''">
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock" Version="$(LabsMarkdownTextBlockVersion)" />
  </ItemGroup>
</Project>
